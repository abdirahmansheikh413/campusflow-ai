# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit these.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security entirely.
.env*
!.env.example

# vercel — project.json carries org/project ids and pulled env vars
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
